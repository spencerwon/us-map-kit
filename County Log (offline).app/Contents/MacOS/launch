#!/bin/bash
# Runs the tracker from this folder on a local web server (saves to the browser only, no account sync).
KIT="$(cd "$(dirname "$0")/../../.." && pwd)"
PORT=8765
if ! lsof -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
  (cd "$KIT" && nohup python3 -m http.server $PORT >/dev/null 2>&1 &)
  sleep 1
fi
open "http://localhost:$PORT/county-tracker.html"
