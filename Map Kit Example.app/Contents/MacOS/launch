#!/bin/bash
# Runs the political choropleth example from this folder on a local web server.
KIT="$(cd "$(dirname "$0")/../../.." && pwd)"
PORT=8765
if ! lsof -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
  (cd "$KIT" && nohup python3 -m http.server $PORT >/dev/null 2>&1 &)
  sleep 1
fi
open "http://localhost:$PORT/apps/political-example.html"
